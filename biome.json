{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.vinxi",
      "!**/.output",
      "!**/.vercel",
      "!**/.tanstack",
      "!**/dist",
      "!**/build",
      "!**/playwright-report",
      "!**/test-results",
      "!**/drizzle",
      "!**/mockup",
      "!**/pnpm-lock.yaml",
      "!**/src/paraglide",
      "!**/src/routeTree.gen.ts"
    ]
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noUndeclaredDependencies": "error"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "useTemplate": "error",
        "useShorthandAssign": "error",
        "useNumberNamespace": "error",
        "noUselessElse": "error",
        "useNodejsImportProtocol": "error",
        "noNegationElse": "error",
        "useDefaultParameterLast": "error",
        "useCollapsedElseIf": "error",
        "useNamingConvention": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "error",
        "noConsole": "error",
        "noEmptyBlockStatements": "error",
        "noDoubleEquals": "error",
        "noImplicitAnyLet": "error",
        "noShadowRestrictedNames": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noUselessFragments": "error",
        "noUselessTypeConstraint": "error",
        "noForEach": "off",
        "useSimplifiedLogicExpression": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error",
        "noAccumulatingSpread": "error"
      },
      "a11y": {
        "useSemanticElements": "error",
        "noStaticElementInteractions": "error",
        "useKeyWithClickEvents": "error",
        "useButtonType": "error",
        "useAriaPropsForRole": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "error",
          "options": {
            "functions": ["clsx", "cn", "cva", "tw"]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 30 }
            }
          },
          "nursery": {
            "useSortedClasses": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/lib/db/**/*.ts",
        "src/lib/server/**/*.ts",
        "drizzle.config.ts",
        "scripts/**/*.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 40 }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/ingest/**/*.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 30 }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  }
}
